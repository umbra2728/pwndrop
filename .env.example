# Created automatically by `make init`; never commit the real .env file.
# This is the only configuration file used by the Compose deployment.
PWN_DROP_LISTEN_IP=0.0.0.0
PWN_DROP_HTTP_PORT=8080
PWN_DROP_HTTPS_PORT=0
PWN_DROP_DATA_DIR=/data
PWN_DROP_ADMIN_DIR=/app/admin

PWN_DROP_SETUP_USERNAME=admin
PWN_DROP_SETUP_PASSWORD=replace-with-a-long-random-password
PWN_DROP_SETUP_SECRET_PATH=/replace-with-a-long-random-path
# Optional. Empty means unknown public URLs receive a 404 response.
PWN_DROP_SETUP_REDIRECT_URL=
